# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DEBUG=True
# Required. `just secret` (or post-generation) writes a real one into .env.
DJANGO_SECRET_KEY=change-me-run-just-secret
PROJECT_NAME="{{ cookiecutter.project_name }}"
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Compose service name; use localhost when running outside the container.
POSTGRES_DB=db_name
POSTGRES_USER=postgres
POSTGRES_PASSWORD=very-secret-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional: set a full DSN to bypass the POSTGRES_* vars entirely.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ---------------------------------------------------------------------------
# CORS / CSRF  (production: list origins explicitly)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# HTTPS  (production only; all default to the safe value)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
# Raise to 31536000 only once TLS is confirmed working on this domain.
SECURE_HSTS_SECONDS=0

# ---------------------------------------------------------------------------
# Throttling
# ---------------------------------------------------------------------------
THROTTLE_RATE_ANON=60/min
THROTTLE_RATE_USER=1000/min

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
LOGGING_TELEGRAM_BOT_TOKEN=
LOGGING_TELEGRAM_CHAT_ID=
# Send full tracebacks to Telegram. Leave off if alerts may reach a shared chat.
LOGGING_TELEGRAM_INCLUDE_TRACEBACK=False

# ---------------------------------------------------------------------------
# Runtime / Docker
# ---------------------------------------------------------------------------
DB_PORT=5400
APP_PORT=8005
WEB_CONCURRENCY=4
# Disable when several replicas boot at once and a job applies migrations.
RUN_MIGRATIONS=True
